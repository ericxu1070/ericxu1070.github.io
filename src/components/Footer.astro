---
// Footer: mono links on left, Lorenz parameters on right
---

<footer class="footer" role="contentinfo">
  <div class="footer__inner container">
    <nav class="footer__links" aria-label="Social and contact links">
      <a href="https://github.com/ericxu1070" class="footer__link" target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
      <a href="https://linkedin.com/in/exu06" class="footer__link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
        LinkedIn
      </a>
      <a href="mailto:ericxu1070@gmail.com" class="footer__link">
        Email
      </a>
    </nav>

    <!-- Lorenz attractor parameters: signature motif -->
    <p class="footer__params" aria-label="Lorenz attractor parameters">
      σ = 10 · ρ = 28 · β = 8/3
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 3px solid var(--ink);
    margin-top: auto;
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-block: 28px;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: center;
  }

  .footer__link {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer__link:hover {
    color: var(--vermilion);
  }

  .footer__params {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
