---
const { project } = Astro.props;
const { title, year, description, tags, repo, demo } = project;
---

<article class="card project-card">
  <div class="card-top">
    <span class="year" aria-label={`Year: ${year}`}>{year}</span>
    <ul class="tags" aria-label="Technologies">
      {tags.map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>
  <div class="card-links">
    {repo && (
      <a href={repo} class="card-link" target="_blank" rel="noopener noreferrer">
        Code -&gt;
      </a>
    )}
    {demo && (
      <a href={demo} class="card-link" target="_blank" rel="noopener noreferrer">
        Demo -&gt;
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .year {
    font-family: "IBM Plex Mono", monospace;
    font-size: 13px;
    font-weight: 500;
    color: var(--vermilion);
    flex-shrink: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
    justify-content: flex-end;
  }

  .tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    border: 2px solid var(--ink);
    padding: 3px 10px;
    background: var(--card);
    color: var(--ink);
    line-height: 1.4;
  }

  .card-title {
    font-family: "Archivo", sans-serif;
    font-size: 22px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--ink);
    margin: 0;
  }

  .card-desc {
    font-family: "Instrument Sans", sans-serif;
    font-size: 15px;
    color: var(--muted);
    line-height: 1.6;
    flex: 1;
    margin: 0;
  }

  .card-links {
    display: flex;
    gap: 20px;
    margin-top: 6px;
  }

  .card-link {
    font-family: "IBM Plex Mono", monospace;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
    transition: color 0.15s ease;
  }

  .card-link:hover {
    color: var(--vermilion);
    text-decoration-color: var(--vermilion);
  }

  .card-link:focus-visible {
    outline: 3px solid var(--ultramarine);
    outline-offset: 2px;
  }
</style>
