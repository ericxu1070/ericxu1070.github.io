---
import fs from "node:fs";
import { projects } from "../data/projects.js";

// Drop a square-ish photo at public/me.jpg and it appears in the header.
const hasPhoto = fs.existsSync("public/me.jpg");
const lastUpdated = new Date().toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eric Xu</title>
    <meta name="description" content="Eric Xu - M.S. student in Scientific Computing and Applied Mathematics at UC Santa Cruz." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main>
      <header class="intro">
        {hasPhoto && <img class="photo" src="/me.jpg" alt="Eric Xu" width="160" height="160" />}
        <div>
          <h1>Eric Xu</h1>
          <p class="contact">
            M.S. student, Scientific Computing and Applied Mathematics<br />
            University of California, Santa Cruz<br />
            Email: ericxu1070[at]gmail[dot]com or exu23[at]ucsc[dot]edu<br />
            <a href="https://github.com/ericxu1070">GitHub</a> ·
            <a href="https://linkedin.com/in/exu06">LinkedIn</a> ·
            <a href="/resume.pdf">Resume (PDF)</a>
          </p>
        </div>
      </header>

      <section>
        <h2>Brief Bio</h2>
        <p>
          I am an M.S. student in Scientific Computing and Applied Mathematics at UC Santa Cruz. I graduated
          from UC Santa Cruz with a B.S. in Applied Mathematics in 2026, with Highest Honors in the Major. I am a
          researcher in the
          TACS Lab, advised by Prof. Ashesh Chattopadhyay, working on
          machine learning for extreme weather prediction. My interests are scientific machine learning, GPU
          computing, and dynamical systems.
        </p>
      </section>

      <section>
        <h2>Research</h2>
        <ul>
          <li>
            <strong>Undergraduate Researcher, TACS Lab</strong> <span class="muted">(Sep 2025 - present)</span><br />
            Developing an ML pipeline for "grey swan" tropical cyclone prediction, coupling a GraphCast global
            weather model with super-resolution downscaling to HRRR (~3 km) resolution. Large-scale training and
            inference on NCAR Derecho and NERSC Perlmutter via SLURM and PBS.
          </li>
        </ul>
        <p class="muted">
          Interests: scientific machine learning and data assimilation; machine learning for weather and climate;
          dynamical systems and numerical methods.
        </p>
      </section>

      <section>
        <h2>Projects</h2>
        <ul>
          {projects.map((p) => (
            <li>
              <strong>{p.title}</strong> <span class="muted">({p.year})</span>
              {p.repo && <> [<a href={p.repo}>code</a>]</>}
              <br />
              {p.description}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Education</h2>
        <ul>
          <li>
            <strong>M.S. Scientific Computing and Applied Mathematics</strong>, UC Santa Cruz <span class="muted">(2026 - 2027)</span>
          </li>
          <li>
            <strong>B.S. Applied Mathematics</strong>, UC Santa Cruz <span class="muted">(2024 - 2026)</span><br />
            Highest Honors in the Major. GPA 3.77 / 4.00. Dean's Honors, 4 quarters. Graduate coursework:
            AM 224, AM 234, AM 261, STAT 266A.
          </li>
        </ul>
      </section>

      <section>
        <h2>Teaching</h2>
        <ul>
          <li>
            <strong>Teaching Assistant</strong>, Baskin School of Engineering <span class="muted">(Fall 2026)</span><br />
            AM 11A Differential Calculus for Economics; AM 20 Ordinary Differential Equations.
          </li>
          <li>
            <strong>Tutor and Reader</strong>, Baskin School of Engineering <span class="muted">(Fall 2025 - Spring 2026)</span><br />
            AM 10 Mathematical Methods I (Linear Algebra), 3 consecutive quarters. Reader for CSE 16 Applied
            Discrete Mathematics; tutor for MATH 19B Calculus II.
          </li>
        </ul>
      </section>

      <section>
        <h2>Skills</h2>
        <p>
          <strong>Programming:</strong> Python, Triton, MATLAB, R, Bash<br />
          <strong>ML and scientific computing:</strong> PyTorch, JAX, NumPy<br />
          <strong>HPC and tools:</strong> SLURM, PBS, Linux, Git, SSH
        </p>
      </section>

      <section>
        <h2>Coursework</h2>
        <p>
          <strong>Applied Mathematics:</strong> Linear Algebra (AM 10), Mathematical Methods II-III (AM 20/100),
          Calculus III (AM 30), Intro to PDEs (AM 112), Dynamical Systems (AM 114), Applied Dynamical Systems
          (AM 224), Mathematical Modeling I-II (AM 170A/B), Scientific Computing (AM 129), Computational Methods
          (AM 147), GPU Programming (AM 148), Scientific Machine Learning (AM 261), ML and AI in Genomics (AM 234).
        </p>
        <p>
          <strong>Statistics and Computer Science:</strong> Probability and Statistics (CSE 107), Classical and
          Bayesian Inference (STAT 132), Applied Discrete Mathematics (CSE 16), Computer Systems and Assembly
          (CSE 12), Financial Mathematics (MATH 114), Introduction to R (STAT 266A).
        </p>
      </section>

      <footer class="muted">Last updated {lastUpdated}.</footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fdfdfb;
    --ink: #1f2328;
    --muted: #5f6670;
    --rule: #dcdcd6;
    --link: #1a4fa0;
    --link-visited: #5b3a9a;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16181c;
      --ink: #e4e4e0;
      --muted: #9aa0a8;
      --rule: #33363c;
      --link: #8ab4f8;
      --link-visited: #c3a6f2;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: "Source Serif 4", Georgia, "Times New Roman", serif;
    font-size: 18px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px 16px 40px;
  }

  a {
    color: var(--link);
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  a:visited {
    color: var(--link-visited);
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  h1 {
    font-size: 2.1rem;
    font-weight: 600;
    line-height: 1.15;
    margin: 0 0 10px;
  }

  h2 {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 12px;
    padding-bottom: 4px;
    border-bottom: 1px dashed var(--rule);
  }

  section {
    margin-top: 36px;
  }

  p {
    margin: 0 0 12px;
  }

  ul {
    margin: 0 0 12px;
    padding-left: 1.2em;
  }

  li {
    margin-bottom: 12px;
  }

  .intro {
    display: flex;
    gap: 28px;
    align-items: center;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--rule);
  }

  .photo {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .contact {
    margin: 0;
    line-height: 1.55;
  }

  .muted {
    color: var(--muted);
  }

  footer {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    font-size: 0.85rem;
  }

  @media (max-width: 540px) {
    body {
      font-size: 17px;
    }

    main {
      padding-top: 32px;
    }

    .intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .photo {
      width: 128px;
      height: 128px;
    }
  }
</style>
