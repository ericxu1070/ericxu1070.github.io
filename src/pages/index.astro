---
import fs from "node:fs";
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects.js";
import { papers } from "../data/papers.js";
import { coursework } from "../data/coursework.js";

// Drop a square-ish photo at public/me.jpg and it appears in the header.
const hasPhoto = fs.existsSync("public/me.jpg");
// Invisible to readers; lets search engines and AI agents identify who this site is about.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Eric Xu",
  url: Astro.site,
  jobTitle: "M.S. student, Scientific Computing and Applied Mathematics",
  affiliation: [
    { "@type": "CollegeOrUniversity", name: "University of California, Santa Cruz" },
    { "@type": "Organization", name: "Vayuh.ai" },
  ],
  alumniOf: { "@type": "CollegeOrUniversity", name: "University of California, Santa Cruz" },
  knowsAbout: ["Scientific machine learning", "Machine learning for weather and climate", "GPU computing", "Dynamical systems", "Data assimilation"],
  sameAs: ["https://github.com/ericxu1070", "https://linkedin.com/in/exu06"],
};
const website = { "@context": "https://schema.org", "@type": "WebSite", name: "Eric Xu", url: Astro.site };
const lastUpdated = new Date().toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<Base title="Eric Xu | Scientific ML & Climate" description="Eric Xu - M.S. student in Scientific Computing and Applied Mathematics at UC Santa Cruz.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(website)} />
  <header class="intro">
    {hasPhoto && <img class="photo" src="/me.jpg" alt="Eric Xu" width="160" height="160" />}
    <div>
      <h1>Eric Xu</h1>
      <p class="contact">
        M.S. student, Scientific Computing and Applied Mathematics<br />
        University of California, Santa Cruz<br />
        Email: <span class="nowrap">ericxu1070[at]gmail[dot]com</span>{" "}
        <span class="nowrap">or exu23[at]ucsc[dot]edu</span><br />
        <a href="https://github.com/ericxu1070">GitHub</a> ·{" "}
        <a href="https://linkedin.com/in/exu06">LinkedIn</a> ·{" "}
        <a href="/resume.pdf">Resume (PDF)</a> ·{" "}
        <a href="/blog">Blog</a>
      </p>
    </div>
  </header>

  <section>
    <h2>Brief Bio</h2>
    <p>
      I am an M.S. student in Scientific Computing and Applied Mathematics at UC Santa Cruz. I graduated
      from UC Santa Cruz with a B.S. in Applied Mathematics in 2026, with Highest Honors in the Major. I am a
      researcher in the
      TACS Lab, advised by Prof. Ashesh Chattopadhyay, working on
      machine learning for extreme weather prediction, and a part-time ML researcher at Vayuh.ai. My interests are scientific machine learning, GPU
      computing, and dynamical systems.
    </p>
  </section>

  <section>
    <h2>Papers and Preprints</h2>
    {papers.length === 0 ? (
      <p class="muted">In preparation.</p>
    ) : (
      <ul>
        {papers.map((p) => (
          <li>
            <strong>{p.title}</strong><br />
            {p.authors}<br />
            <em>{p.venue}</em>, {p.year}
            {p.links?.map((l) => <> [<a href={l.url}>{l.label}</a>]</>)}
          </li>
        ))}
      </ul>
    )}
  </section>

  <section>
    <h2>Research</h2>
    <ul>
      <li>
        <strong>Researcher, TACS Lab</strong> <span class="muted">(Sep 2025 - present)</span><br />
        Building AI ensemble forecasts of heat waves and cold outbreaks three weeks ahead, combining AI global
        weather models with rare-event resampling, plus diffusion-based downscaling to HRRR (~3 km) resolution.
        Large-scale training and inference on cloud GPUs and NCAR Derecho via SLURM and PBS.
      </li>
      <li>
        <strong>ML Researcher (part-time), Vayuh.ai</strong> <span class="muted">(Jul 2026 - present)</span><br />
        Multi-GPU training and inference experiments for subseasonal extreme-weather forecasting on cloud H100
        nodes and NCAR Derecho.
      </li>
    </ul>
    <p class="muted">
      Interests: scientific machine learning and data assimilation; machine learning for weather and climate;
      dynamical systems and numerical methods.
    </p>
  </section>

  <section>
    <h2>Projects</h2>
    <ul>
      {projects.map((p) => (
        <li>
          <strong>{p.title}</strong> <span class="muted">({p.year})</span>
          {p.repo && <> [<a href={p.repo}>code</a>]</>}
          <br />
          {p.description}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Education</h2>
    <ul>
      <li>
        <strong>M.S. Scientific Computing and Applied Mathematics</strong>, UC Santa Cruz <span class="muted">(2026 - 2027)</span>
      </li>
      <li>
        <strong>B.S. Applied Mathematics</strong>, UC Santa Cruz <span class="muted">(2024 - 2026)</span><br />
        Highest Honors in the Major. GPA 3.77 / 4.00. Dean's Honors, 4 quarters. Graduate coursework:
        AM 224, AM 234, AM 261, STAT 266A.
      </li>
    </ul>
  </section>

  <section>
    <h2>Teaching</h2>
    <ul>
      <li>
        <strong>Teaching Assistant</strong>, Baskin School of Engineering <span class="muted">(Fall 2026)</span><br />
        AM 11A Differential Calculus for Economics; AM 20 Ordinary Differential Equations.
      </li>
      <li>
        <strong>Tutor and Reader</strong>, Baskin School of Engineering <span class="muted">(Fall 2025 - Spring 2026)</span><br />
        AM 10 Mathematical Methods I (Linear Algebra), 3 consecutive quarters. Reader for CSE 16 Applied
        Discrete Mathematics; tutor for MATH 19B Calculus II.
      </li>
    </ul>
  </section>

  <section>
    <h2>Skills</h2>
    <p>
      <strong>Programming:</strong> Python, C++, MATLAB, R, Bash, RISC-V assembly<br />
      <strong>Machine learning and scientific computing:</strong> PyTorch, JAX, NumPy, scikit-learn, Triton (GPU kernels)<br />
      <strong>HPC and tools:</strong> SLURM, PBS, cloud H100 nodes, NCAR Derecho, Linux, Git, SSH<br />
      <strong>Mathematical areas:</strong> Linear algebra, differential equations, PDEs, dynamical systems,
      numerical methods, deep learning
    </p>
  </section>

  <section>
    <h2>Coursework</h2>
    {coursework.map((g) => (
      <>
        <h3>{g.group}</h3>
        <table class="courses">
          <tbody>
            {g.courses.map(([code, name]) => (
              <tr>
                <td class="muted">{code}</td>
                <td>{name}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    ))}
  </section>

  <footer class="muted">Last updated {lastUpdated}.</footer>
</Base>
