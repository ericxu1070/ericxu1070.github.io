---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout title={note.data.title} description={note.data.description}>
  <div class="container note-container">
    <div class="note-chrome">
      <a href="/notes" class="breadcrumb">&larr; All notes</a>

      <div class="meta-row">
        <span class="tag">{note.data.topic}</span>
        <span class="note-date">{formatDate(note.data.date)}</span>
      </div>

      <h1 class="note-heading">{note.data.title}</h1>
    </div>

    <article class="prose">
      <Content />
    </article>
  </div>
</BaseLayout>

<style>
  .note-container {
    padding-block: clamp(48px, 7vw, 80px);
  }

  .note-chrome {
    max-width: 720px;
    margin-bottom: 40px;
  }

  .breadcrumb {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: inline-block;
    margin-bottom: 28px;
    transition: color 0.15s ease;
  }

  .breadcrumb:hover {
    color: var(--vermilion);
  }

  .breadcrumb:focus-visible {
    outline: 3px solid var(--ultramarine);
    outline-offset: 2px;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .note-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--vermilion);
    font-weight: 400;
  }

  .note-heading {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--ink);
    max-width: 720px;
  }
</style>

<style is:global>
  .prose {
    max-width: 720px;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink);
  }

  .prose p {
    margin-block: 1.1em;
  }

  .prose h2 {
    font-family: 'Archivo', sans-serif;
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink);
    margin-top: 2.8em;
    margin-bottom: 0.75em;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .prose h2::after {
    content: '';
    flex: 1;
    height: 3px;
    background: var(--ink);
    display: block;
  }

  .prose h3 {
    font-family: 'Archivo', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin-top: 2em;
    margin-bottom: 0.6em;
  }

  .prose code {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.9em;
    background: rgba(20, 20, 18, 0.06);
    padding: 2px 6px;
  }

  /* Shiki code blocks: preserve shiki background, add editorial border */
  .prose pre.astro-code {
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    padding: 20px;
    overflow-x: auto;
    margin-block: 1.6em;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 14px;
    line-height: 1.6;
  }

  /* Reset inline code inside pre blocks */
  .prose pre.astro-code code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose ul,
  .prose ol {
    padding-inline-start: 1.5em;
    margin-block: 1em;
  }

  .prose li {
    margin-block: 0.35em;
  }

  /* KaTeX display math: allow horizontal scroll on narrow viewports */
  .prose .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.25em;
    -webkit-overflow-scrolling: touch;
  }

  /* Strong and em */
  .prose strong {
    font-weight: 600;
  }

  .prose em {
    font-style: italic;
  }
</style>
