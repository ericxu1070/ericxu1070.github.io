---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');

// Group notes by topic
const byTopic = allNotes.reduce<Record<string, typeof allNotes>>((acc, note) => {
  const topic = note.data.topic;
  if (!acc[topic]) acc[topic] = [];
  acc[topic].push(note);
  return acc;
}, {});

// Sort each topic's notes by date descending
for (const topic of Object.keys(byTopic)) {
  byTopic[topic].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
}

// Sort topics alphabetically
const topics = Object.keys(byTopic).sort();

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout title="Notes" description="Things that I want to remember">
  <section class="section page-hero">
    <div class="container">
      <h1 class="reveal" style="--reveal-delay: 0.05s">NOTES</h1>
      <p class="standfirst reveal" style="--reveal-delay: 0.15s">
        Some things that I wanted to write down.
      </p>
    </div>
  </section>

  {topics.map((topic, topicIndex) => (
    <section class="section topic-section">
      <div class="container">
        <div class="section-head scroll-reveal">
          <span class="eyebrow">{topic}</span>
        </div>
        <div class="notes-grid">
          {byTopic[topic].map((note, noteIndex) => (
            <a
              href={`/notes/${note.id}`}
              class="card note-card scroll-reveal"
              style={`--reveal-delay: ${noteIndex * 0.08}s`}
            >
              <p class="note-date">{formatDate(note.data.date)}</p>
              <h3 class="note-title">{note.data.title}</h3>
              <p class="note-desc">{note.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(64px, 10vw, 112px) clamp(32px, 5vw, 56px);
  }

  .page-hero h1 {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(56px, 11vw, 128px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .standfirst {
    margin-top: 24px;
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 400;
    color: var(--muted);
    max-width: 560px;
    line-height: 1.55;
  }

  .topic-section {
    padding-block-start: 0;
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }

  .note-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .note-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--vermilion);
    margin-bottom: 10px;
    font-weight: 400;
  }

  .note-title {
    font-family: 'Archivo', sans-serif;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .note-desc {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 15px;
    color: var(--muted);
    line-height: 1.6;
  }
</style>
