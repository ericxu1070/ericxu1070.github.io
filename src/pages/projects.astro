---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects.js";
---

<BaseLayout title="Projects" description="All projects">

  <!-- PAGE HERO -->
  <section class="section projects-hero">
    <div class="container">
      <h1 class="projects-title">PROJECTS</h1>
      <p class="projects-standfirst">
        Things I have accumulated over time.
      </p>
    </div>
  </section>

  <!-- ALL PROJECTS GRID -->
  <section class="section projects-list-section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">All work</span>
      </div>
      <div class="projects-grid">
        {projects.map((project, i) => (
          <div class="scroll-reveal" style={`--reveal-delay: ${(i % 3) * 0.08}s`}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .projects-hero {
    padding-bottom: clamp(32px, 5vw, 56px);
  }

  .projects-title {
    font-family: "Archivo", sans-serif;
    font-size: clamp(48px, 10vw, 112px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 24px 0;
  }

  .projects-standfirst {
    font-family: "Instrument Sans", sans-serif;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 560px;
    margin: 0;
  }

  .projects-list-section {
    padding-top: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }
</style>
