---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="For recruiters" description="A quick summary of Eric Xu's focus, skills, and availability for internships.">

  <!-- PAGE HERO -->
  <section class="section recruiters-hero">
    <div class="container">
      <h1 class="recruiters-title">FOR<br />RECRUITERS</h1>
      <p class="recruiters-standfirst">
        The short version, for people deciding whether to interview me.
      </p>
    </div>
  </section>

  <!-- AT A GLANCE -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">At a glance</span>
      </div>
      <div class="glance-grid">

        <div class="card glance-card scroll-reveal" style="--reveal-delay: 0s">
          <p class="glance-label">Focus</p>
          <p class="glance-value">Scientific machine learning, GPU computing, and applied mathematics.</p>
        </div>

        <div class="card glance-card scroll-reveal" style="--reveal-delay: 0.08s">
          <p class="glance-label">Stack</p>
          <p class="glance-value">Python, C/CUDA, JAX, PyTorch. SLURM/PBS on HPC clusters. Linux, Git.</p>
        </div>

        <div class="card glance-card scroll-reveal" style="--reveal-delay: 0.16s">
          <p class="glance-label">Status</p>
          <p class="glance-value">
            Starting an M.S. in Applied Mathematics at UC Santa Cruz, Fall 2026.
            <!-- PLACEHOLDER: Eric to state what he is currently seeking (internships, research roles, etc.) -->
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- EDUCATION -->
  <section class="section scroll-reveal">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Education</span>
      </div>
      <ol class="timeline" aria-label="Education">
        <li class="timeline-entry">
          <p class="timeline-date">Incoming Fall 2026</p>
          <h2 class="timeline-role">M.S. Applied Mathematics</h2>
          <p class="timeline-org">University of California, Santa Cruz</p>
        </li>
        <li class="timeline-entry">
          <p class="timeline-date">June 2026</p>
          <h2 class="timeline-role">B.S. Applied Mathematics</h2>
          <p class="timeline-org">University of California, Santa Cruz</p>
          <ul class="timeline-bullets">
            <li>Highest Honors in the Major. GPA 3.77 / 4.00. Dean's Honors, 4 quarters.</li>
            <li>Graduate coursework as an undergraduate: AM 224, AM 234, AM 261, STAT 266A.</li>
          </ul>
        </li>
      </ol>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="section scroll-reveal">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Experience</span>
      </div>
      <ol class="timeline" aria-label="Work experience">

        <li class="timeline-entry">
          <p class="timeline-date">September 2025 - Present</p>
          <h2 class="timeline-role">Undergraduate Researcher</h2>
          <p class="timeline-org">TACS Lab (Prof. Ashesh Chattopadhyay), UC Santa Cruz</p>
          <ul class="timeline-bullets">
            <li>Developing an ML pipeline for "grey swan" tropical cyclone prediction, coupling a GraphCast global weather model with super-resolution downscaling to HRRR (~3 km) resolution.</li>
            <li>Running large-scale training and inference on NCAR (Derecho) and NERSC (Perlmutter) HPC clusters via SLURM and PBS schedulers.</li>
          </ul>
        </li>

        <li class="timeline-entry">
          <p class="timeline-date">Fall 2025 - Spring 2026</p>
          <h2 class="timeline-role">Undergraduate Tutor & Reader</h2>
          <p class="timeline-org">Baskin School of Engineering, UC Santa Cruz</p>
          <ul class="timeline-bullets">
            <li>AM 10 Mathematical Methods I (Linear Algebra), tutor and reader for 3 consecutive quarters: weekly tutoring and office hours, grading against instructor rubrics.</li>
            <li>Reader for CSE 16 Applied Discrete Mathematics and tutor for MATH 19B Calculus II.</li>
          </ul>
        </li>

      </ol>
    </div>
  </section>

  <!-- SKILLS -->
  <section class="section scroll-reveal">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Skills</span>
      </div>
      <div class="skills-groups">

        <div class="skills-row">
          <p class="skills-label">Programming</p>
          <ul class="skills-tags" aria-label="Programming languages">
            <li class="tag">Python</li>
            <li class="tag">C/CUDA</li>
            <li class="tag">MATLAB</li>
            <li class="tag">R</li>
            <li class="tag">Bash</li>
          </ul>
        </div>

        <div class="skills-row">
          <p class="skills-label">ML & SciComp</p>
          <ul class="skills-tags" aria-label="Machine learning and scientific computing">
            <li class="tag">PyTorch</li>
            <li class="tag">JAX</li>
            <li class="tag">NumPy</li>
            <li class="tag">Triton</li>
          </ul>
        </div>

        <div class="skills-row">
          <p class="skills-label">HPC & Tools</p>
          <ul class="skills-tags" aria-label="HPC and tools">
            <li class="tag">SLURM</li>
            <li class="tag">PBS</li>
            <li class="tag">Linux</li>
            <li class="tag">Git</li>
            <li class="tag">SSH</li>
          </ul>
        </div>

        <div class="skills-row">
          <p class="skills-label">Math Areas</p>
          <ul class="skills-tags" aria-label="Mathematical areas">
            <li class="tag">Linear algebra</li>
            <li class="tag">PDEs</li>
            <li class="tag">Dynamical systems</li>
            <li class="tag">Numerical methods</li>
            <li class="tag">Deep learning</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- CV DOWNLOAD -->
  <section class="section cv-section scroll-reveal">
    <div class="container">
      <div class="cv-block">
        <a href="/resume.pdf" class="btn btn--accent" download>Download CV</a>
        <p class="cv-note">PDF - one page</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .recruiters-hero {
    padding-bottom: clamp(32px, 5vw, 56px);
  }

  .recruiters-title {
    font-family: "Archivo", sans-serif;
    font-size: clamp(44px, 9vw, 112px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 24px 0;
  }

  .recruiters-standfirst {
    font-family: "Instrument Sans", sans-serif;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 560px;
    margin: 0;
  }

  /* AT A GLANCE */
  .glance-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
  }

  .glance-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .glance-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--vermilion);
    margin: 0;
  }

  .glance-value {
    font-family: "Instrument Sans", sans-serif;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
    margin: 0;
  }

  /* EXPERIENCE TIMELINE */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-entry {
    padding: 28px 0 28px 24px;
    border-left: 3px solid var(--ink);
    position: relative;
  }

  .timeline-entry + .timeline-entry {
    margin-top: 4px;
  }

  .timeline-date {
    font-family: "IBM Plex Mono", monospace;
    font-size: 13px;
    font-weight: 500;
    color: var(--vermilion);
    margin: 0 0 6px 0;
  }

  .timeline-role {
    font-family: "Archivo", sans-serif;
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 4px 0;
  }

  .timeline-org {
    font-family: "Instrument Sans", sans-serif;
    font-size: 15px;
    color: var(--muted);
    margin: 0 0 14px 0;
  }

  .timeline-bullets {
    list-style: disc;
    padding-left: 18px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .timeline-bullets li {
    font-family: "Instrument Sans", sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
  }

  /* SKILLS */
  .skills-groups {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .skills-row {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
  }

  .skills-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin: 0;
    padding-top: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* CV DOWNLOAD */
  .cv-section {
    border-top: none;
  }

  .cv-block {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cv-note {
    font-family: "IBM Plex Mono", monospace;
    font-size: 13px;
    color: var(--muted);
    margin: 0;
  }
</style>
