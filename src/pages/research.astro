---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Research" description="Eric Xu's research in scientific machine learning, weather and climate modeling, and dynamical systems.">

  <!-- PAGE HERO -->
  <section class="section research-hero">
    <div class="container">
      <h1 class="research-title">RESEARCH</h1>
      <p class="research-standfirst">
        Work at the boundary of applied mathematics, machine learning, and scientific computing. Starting an M.S. in Applied Mathematics at UC Santa Cruz in Fall 2026.
      </p>
    </div>
  </section>

  <!-- CURRENT RESEARCH -->
  <section class="section scroll-reveal">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Current research</span>
      </div>
      <article class="card research-position">
        <p class="research-date">September 2025 - Present</p>
        <h2 class="interest-title">Undergraduate Researcher, TACS Lab</h2>
        <p class="interest-desc">
          Advised by Prof. Ashesh Chattopadhyay at UC Santa Cruz. Developing an ML pipeline for "grey swan" tropical cyclone prediction that couples a GraphCast global weather model with super-resolution downscaling to HRRR (~3 km) resolution, with large-scale training and inference on NCAR (Derecho) and NERSC (Perlmutter) HPC clusters via SLURM and PBS schedulers.
        </p>
      </article>
    </div>
  </section>

  <!-- INTERESTS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Interests</span>
      </div>
      <div class="interests-grid">

        <article class="card scroll-reveal" style="--reveal-delay: 0s">
          <h2 class="interest-title">Scientific Machine Learning &amp; Data Assimilation</h2>
          <p class="interest-desc">
            Variational methods, learned operators, and hybrid physics-ML models for state estimation and prediction.
            Current work includes learning inverse observation operators for 4D-Var assimilation on chaotic systems.
          </p>
        </article>

        <article class="card scroll-reveal" style="--reveal-delay: 0.08s">
          <h2 class="interest-title">Machine Learning for Weather and Climate</h2>
          <p class="interest-desc">
            Global weather models, statistical downscaling, and extreme-event prediction. Current focus is coupling
            GraphCast with super-resolution downscaling to forecast "grey-swan" tropical cyclone intensification at
            convection-permitting (~3 km) resolution.
          </p>
        </article>

        <article class="card scroll-reveal" style="--reveal-delay: 0.16s">
          <h2 class="interest-title">Dynamical Systems &amp; Numerical Methods</h2>
          <p class="interest-desc">
            Modeling and simulation of chaotic systems such as Lorenz-96 and Kolmogorov flow. Interested in the
            interaction between numerical discretization, long-time integration, and the geometric structure of
            attractors.
          </p>
        </article>

      </div>
    </div>
  </section>

  <!-- PUBLICATIONS -->
  <section class="section scroll-reveal">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Publications</span>
      </div>
      <div class="empty-state" role="status">
        <p class="empty-message">Publications will be listed here as they happen.</p>
        <p class="empty-sub">
          In the meantime, see the <a href="/notes" class="inline-link">notes</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- COURSEWORK -->
  <section class="section scroll-reveal">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Coursework</span>
      </div>
      <div class="coursework-groups">
        <div class="course-group">
          <p class="course-group-label">Applied Mathematics</p>
          <ul class="course-list" aria-label="Applied mathematics coursework">
            <li class="course-item"><span class="course-code">AM 10</span><span class="course-name">Linear Algebra</span></li>
            <li class="course-item"><span class="course-code">AM 20 / 100</span><span class="course-name">Mathematical Methods II-III</span></li>
            <li class="course-item"><span class="course-code">AM 30</span><span class="course-name">Calculus III</span></li>
            <li class="course-item"><span class="course-code">AM 112</span><span class="course-name">Intro to PDEs</span></li>
            <li class="course-item"><span class="course-code">AM 114</span><span class="course-name">Dynamical Systems</span></li>
            <li class="course-item"><span class="course-code">AM 224</span><span class="course-name">Applied Dynamical Systems</span></li>
            <li class="course-item"><span class="course-code">AM 170A/B</span><span class="course-name">Mathematical Modeling I-II</span></li>
            <li class="course-item"><span class="course-code">AM 129</span><span class="course-name">Scientific Computing</span></li>
            <li class="course-item"><span class="course-code">AM 147</span><span class="course-name">Computational Methods</span></li>
            <li class="course-item"><span class="course-code">AM 148</span><span class="course-name">GPU Programming</span></li>
            <li class="course-item"><span class="course-code">AM 261</span><span class="course-name">Scientific Machine Learning</span></li>
            <li class="course-item"><span class="course-code">AM 234</span><span class="course-name">ML & AI in Genomics</span></li>
          </ul>
        </div>
        <div class="course-group">
          <p class="course-group-label">Statistics & Computer Science</p>
          <ul class="course-list" aria-label="Statistics and computer science coursework">
            <li class="course-item"><span class="course-code">CSE 107</span><span class="course-name">Probability & Statistics</span></li>
            <li class="course-item"><span class="course-code">STAT 132</span><span class="course-name">Classical & Bayesian Inference</span></li>
            <li class="course-item"><span class="course-code">CSE 16</span><span class="course-name">Applied Discrete Mathematics</span></li>
            <li class="course-item"><span class="course-code">CSE 12</span><span class="course-name">Computer Systems & Assembly</span></li>
            <li class="course-item"><span class="course-code">MATH 114</span><span class="course-name">Financial Mathematics</span></li>
            <li class="course-item"><span class="course-code">STAT 266A</span><span class="course-name">Introduction to R</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .research-hero {
    padding-bottom: clamp(32px, 5vw, 56px);
  }

  .research-title {
    font-family: "Archivo", sans-serif;
    font-size: clamp(48px, 10vw, 112px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 24px 0;
  }

  .research-standfirst {
    font-family: "Instrument Sans", sans-serif;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 600px;
    margin: 0;
  }

  /* INTERESTS */
  .interests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .interest-title {
    font-family: "Archivo", sans-serif;
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 12px 0;
  }

  .interest-desc {
    font-family: "Instrument Sans", sans-serif;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
  }

  /* PUBLICATIONS EMPTY STATE */
  .empty-state {
    border: 3px dashed var(--muted);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 560px;
  }

  .empty-message {
    font-family: "Instrument Sans", sans-serif;
    font-size: 17px;
    color: var(--ink);
    margin: 0;
  }

  .empty-sub {
    font-family: "IBM Plex Mono", monospace;
    font-size: 13px;
    color: var(--muted);
    margin: 0;
  }

  .inline-link {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
    transition: color 0.15s ease;
  }

  .inline-link:hover {
    color: var(--vermilion);
    text-decoration-color: var(--vermilion);
  }

  .inline-link:focus-visible {
    outline: 3px solid var(--ultramarine);
    outline-offset: 2px;
  }

  /* CURRENT RESEARCH */
  .research-position {
    max-width: 760px;
  }

  .research-date {
    font-family: "IBM Plex Mono", monospace;
    font-size: 13px;
    font-weight: 500;
    color: var(--vermilion);
    margin: 0 0 8px 0;
  }

  /* COURSEWORK */
  .coursework-groups {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .course-group-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin: 0 0 8px 0;
  }

  .course-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    max-width: 680px;
  }

  .course-item {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid rgba(20, 20, 18, 0.15);
  }

  .course-item:nth-last-child(-n+2) {
    border-bottom: none;
  }

  .course-code {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    font-weight: 500;
    color: var(--vermilion);
    flex-shrink: 0;
    min-width: 72px;
  }

  .course-name {
    font-family: "Instrument Sans", sans-serif;
    font-size: 15px;
    color: var(--ink);
    line-height: 1.4;
  }

  @media (max-width: 600px) {
    .course-list {
      grid-template-columns: 1fr;
    }

    .course-item:nth-last-child(-n+2) {
      border-bottom: 1px solid rgba(20, 20, 18, 0.15);
    }

    .course-item:last-child {
      border-bottom: none;
    }
  }
</style>
